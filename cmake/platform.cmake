# The platform variables the generated GN data is conditioned on, standing for GN's is_win, is_mac,
# current_cpu and the rest.

set(PDFINATE_IS_WIN FALSE)
set(PDFINATE_IS_APPLE FALSE)
set(PDFINATE_IS_MAC FALSE)
set(PDFINATE_IS_IOS FALSE)
set(PDFINATE_IS_ANDROID FALSE)
set(PDFINATE_IS_LINUX FALSE)
set(PDFINATE_IS_POSIX FALSE)

if(WIN32)
    set(PDFINATE_IS_WIN TRUE)
elseif(APPLE)
    set(PDFINATE_IS_APPLE TRUE)
    set(PDFINATE_IS_POSIX TRUE)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set(PDFINATE_IS_IOS TRUE)
    else()
        set(PDFINATE_IS_MAC TRUE)
    endif()
elseif(ANDROID)
    set(PDFINATE_IS_ANDROID TRUE)
    set(PDFINATE_IS_POSIX TRUE)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(PDFINATE_IS_LINUX TRUE)
    set(PDFINATE_IS_POSIX TRUE)
elseif(UNIX)
    set(PDFINATE_IS_POSIX TRUE)
endif()

# GN's CPU names. On Apple the architecture to build for is CMAKE_OSX_ARCHITECTURES when set, not
# the host's. A universal build (two architectures in one) is not supported: highway and
# libjpeg-turbo choose their code per CPU at configure time.
set(_cpu "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _n)
    if(_n GREATER 1)
        message(FATAL_ERROR "PDFinate: build one architecture at a time (CMAKE_OSX_ARCHITECTURES is "
                            "${CMAKE_OSX_ARCHITECTURES}), and combine the results with lipo.")
    endif()
    set(_cpu "${CMAKE_OSX_ARCHITECTURES}")
endif()
string(TOLOWER "${_cpu}" _cpu)
if(_cpu MATCHES "^(arm64|aarch64|arm64e)$")
    set(PDFINATE_CPU arm64)
elseif(_cpu MATCHES "^(x86_64|amd64|x64)$")
    set(PDFINATE_CPU x64)
elseif(_cpu MATCHES "^(i[3-6]86|x86)$")
    set(PDFINATE_CPU x86)
elseif(_cpu MATCHES "^arm")
    set(PDFINATE_CPU arm)
else()
    set(PDFINATE_CPU "${_cpu}")
endif()
unset(_cpu)
unset(_n)
